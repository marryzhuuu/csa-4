{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pytest with --update-goldens",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--update-goldens",
                "${workspaceFolder}/tests/golden_test.py"  
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}